# Jovo Environment Configuration Example
# Copy this file to .env and configure values for your environment.
# NEVER commit the real .env file.

# ----------------------------------------
# Backend API (FastAPI)
# ----------------------------------------
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
DATABASE_URL=postgresql://jobos:jobos_password@localhost:5432/jobos

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,chrome-extension://*

# ----------------------------------------
# External Intelligence Services
# ----------------------------------------
# SerpApi - Web Job Discovery & Intelligence
SERPAPI_API_KEY=your_serpapi_api_key_here

# LLM Provider - Career Intelligence & Generation
# (e.g. Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Optional: GitHub API Token (for evidence fetching, public rate limits apply without it)
GITHUB_TOKEN=your_optional_github_token_here

# ----------------------------------------
# Web Application (Next.js)
# ----------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----------------------------------------
# Chrome Extension
# ----------------------------------------
EXTENSION_API_URL=http://localhost:8000
